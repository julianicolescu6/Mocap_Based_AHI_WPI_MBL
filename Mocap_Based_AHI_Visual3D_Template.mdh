Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Mass
/METRIC_VALUE=61.23
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Height
/METRIC_VALUE=1.735
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Gravity
/METRIC_VALUE=9.81
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Segment_to_COFP_Distance
/METRIC_VALUE=0.2
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Joint_Radius_Ratio
/METRIC_VALUE=0.425
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Marker_Radius
/METRIC_VALUE=0.00475
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=MTI_proxMTV_proxdist
/METRIC_VALUE=DISTANCE(R_MTI_PROX,R_MTV_PROX)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LMTI_proxMTV_proxdist
/METRIC_VALUE=DISTANCE(L_MTI_prox,L_MTV_prox)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RProxFFscale
/METRIC_VALUE=(MTI_proxMTV_proxdist - Marker_Radius)/(2*MTI_proxMTV_proxdist)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LProxFFscale
/METRIC_VALUE=(LMTI_proxMTV_proxdist - Marker_Radius)/(2*LMTI_proxMTV_proxdist)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RFT_Distal_Radius
/METRIC_VALUE=0.02
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RFT_Proximal_Radius
/METRIC_VALUE=0.02
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LFT_Distal_Radius
/METRIC_VALUE=0.02
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LFT_Proximal_Radius
/METRIC_VALUE=0.02
;
